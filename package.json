{
  "name": "realtime-voice-harness",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Text-in/text-out test harness for realtime voice apps with agentic harnesses.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs",
    "prepack": "bun run build",
    "build:esm": "tsgo -p tsconfig.build.json",
    "build:cjs": "tsgo -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.mjs",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.examples.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "test:examples": "bun run build && bun run test:bun && bun run test:node && bun run test:jest && bun run test:playwright && bun run test:langchain && bun run test:tanstack && bun run test:local-speech && bun run test:openai-realtime && bun run test:midscene",
    "test:bun": "bun test examples/bun",
    "test:node": "node --test \"examples/node/**/*.test.mjs\"",
    "test:jest": "jest --config examples/jest/jest.config.cjs",
    "test:playwright": "playwright test --config examples/playwright/playwright.config.ts",
    "test:langchain": "vitest run --config vitest.examples.config.ts examples/langchain",
    "test:local-speech": "vitest run --config vitest.examples.config.ts examples/local-speech",
    "test:tanstack": "vitest run --config vitest.examples.config.ts examples/tanstack",
    "test:openai-realtime": "vitest run --config vitest.examples.config.ts examples/openai-realtime",
    "test:midscene": "playwright test --config examples/midscene/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@langchain/core": "^1.3.7",
    "@midscene/web": "^1.17.8",
    "@playwright/test": "^1.55.0",
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-types": "^1.4.4",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "realtime-voice-harness": "file:.",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tanstack/ai": "^1.4.0"
  }
}
